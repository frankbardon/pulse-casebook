   "field": "pop",
   "label": "pop"
  },
  {
   "type": "AGG_MAX",
   "field": "jac",
   "label": "jac"
  },
  {
   "type": "AGG_MAX",
   "field": "inter",
   "label": "inter"
  },
  {
   "type": "AGG_MAX",
   "field": "all",
   "label": "all"
  },
  {
