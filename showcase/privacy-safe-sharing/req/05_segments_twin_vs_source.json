{
  "requests": [
    {
      "label": "contract",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
          "label": "twin"
        }
      ],
      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_CATEGORY",
          "field": "contract"
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "churned",
          "label": "churn_rate"
        }
      ]
    },
    {
      "label": "plan",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
          "label": "twin"
        }
      ],
      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_CATEGORY",
          "field": "plan"
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "churned",
          "label": "churn_rate"
        }
      ]
    },
    {
      "label": "autopay",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
          "label": "twin"
        }
      ],
      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_CATEGORY",
          "field": "autopay"
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "churned",
          "label": "churn_rate"
        }
      ]
    },
    {
      "label": "contacts",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
          "label": "twin"
        }
      ],
      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_CATEGORY",
          "field": "support_contacts",
          "include": [
            "0",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7"
          ]
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "churned",
          "label": "churn_rate"
        }
      ]
    },
    {
      "label": "tenure",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
          "label": "twin"
        }
      ],
      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_RANGE",
          "field": "tenure_months",
          "interval": 12
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "churned",
          "label": "churn_rate"
        }
      ]
    },
    {
      "label": "spend_by_product",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
          "label": "twin"
        }
      ],
      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_SET_PER_ELEMENT",
          "field": "products_held"
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "monthly_spend",
          "label": "avg_monthly_spend_usd"
        }
      ]
    },
    {
      "label": "spend_by_plan",
      "union": [
        {
          "cohort": {
            "filename": "customers.pulse",
            "data_dir": "."
          },
          "label": "source"
        },
        {
          "cohort": {
            "filename": "twin.pulse",
            "data_dir": "."
          },
