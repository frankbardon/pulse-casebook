      "groups": [
        {
          "field": "_source"
        },
        {
          "type": "GROUP_CATEGORY",
          "field": "plan"
        }
      ],
      "aggregations": [
        {
          "type": "AGG_AVERAGE",
          "field": "monthly_spend",
          "label": "avg_monthly_spend_usd"
        }
      ]
    }
  ]
