{
  "cohort": {
    "filename": "ab_test.pulse",
    "data_dir": "."
  },
  "attributes": [
    {
      "type": "ATTR_FORMULA",
      "field": "trial_started",
      "label": "trial",
      "expression": "trial_started == \"yes\" ? 1 : 0"
    },
    {
      "type": "ATTR_FORMULA",
      "field": "device",
      "label": "mobile",
      "expression": "device == \"mobile\" ? 1 : 0"
    },
    {
      "type": "ATTR_FORMULA",
      "field": "device",
      "label": "new_page_x_mobile",
      "expression": "(device == \"mobile\" && arm == \"new_page\") ? 1 : 0"
    },
    {
      "type": "ATTR_FORMULA",
      "field": "region",
      "label": "na",
      "expression": "region == \"NA\" ? 1 : 0"
    },
    {
      "type": "ATTR_FORMULA",
      "field": "region",
      "label": "new_page_x_na",
      "expression": "(region == \"NA\" && arm == \"new_page\") ? 1 : 0"
    }
  ],
  "regressions": [
    {
      "type": "REG_OLS",
      "name": "trial_by_mobile",
      "target": "trial",
      "predictors": [
        "is_variant",
        "mobile",
        "new_page_x_mobile"
      ],
      "multiplicity": {
        "method": "holm",
        "coefficients": [
          "new_page_x_mobile"
        ]
      }
    },
    {
      "type": "REG_OLS",
      "name": "trial_by_na",
      "target": "trial",
      "predictors": [
        "is_variant",
        "na",
        "new_page_x_na"
      ],
      "multiplicity": {
        "method": "holm",
        "coefficients": [
          "new_page_x_na"
        ]
      }
    }
  ],
  "multiplicity": {
    "method": "holm",
    "family": "request"
  }
}
