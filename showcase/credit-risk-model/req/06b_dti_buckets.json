{
  "cohort": {
    "filename": "loans.pulse",
    "data_dir": "."
  },
  "groups": [
    {
      "type": "GROUP_NUMERIC_RANGES",
      "field": "dti",
      "params": {
        "ranges": [
          {
            "label": "under 10%",
            "end": 10
          },
          {
            "label": "10-20%",
            "start": 10,
            "end": 20
          },
          {
            "label": "20-30%",
            "start": 20,
            "end": 30
          },
          {
            "label": "30% and over",
            "start": 30
          }
        ]
      }
    }
  ],
  "aggregations": [
    {
      "type": "AGG_COUNT",
      "field": "loan_id",
      "label": "loans"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "default_12m",
      "label": "default_rate"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "dti",
      "label": "mean_dti"
    }
  ]
}
