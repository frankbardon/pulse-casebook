{
  "cohort": {
    "filename": "brand_tracker.pulse",
    "data_dir": "."
  },
  "weight": {
    "field": "weight",
    "kind": "probability"
  },
  "attributes": [
    {
      "type": "ATTR_FORMULA",
      "field": "intent",
      "label": "intent_t2b",
      "expression": "intent == nil ? nil : (intent >= 4 ? 1 : 0)"
    },
    {
      "type": "ATTR_FORMULA",
      "field": "nps",
      "label": "nps_score",
      "expression": "nps == nil ? nil : (nps >= 9 ? 100 : (nps <= 6 ? -100 : 0))"
    }
  ],
  "groups": [
    {
      "type": "GROUP_CATEGORY",
      "field": "wave"
    }
  ],
  "aggregations": [
    {
      "type": "AGG_AVERAGE",
      "field": "aware_aided",
      "label": "aided"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "aware_unaided",
      "label": "unaided"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "consider",
      "label": "consider"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "intent_t2b",
      "label": "intent_t2b"
    },
    {
      "type": "AGG_AVERAGE",
      "field": "nps_score",
      "label": "nps"
    },
    {
      "type": "AGG_VARIANCE",
      "field": "nps_score",
      "label": "nps_variance"
    }
  ],
  "overlays": [
    {
      "name": "aided_change",
      "kind": "OVERLAY_DELTA_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "aided"
      }
    },
    {
      "name": "aided_test",
      "kind": "OVERLAY_PROP_Z_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "aided"
      }
    },
    {
      "name": "unaided_change",
      "kind": "OVERLAY_DELTA_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "unaided"
      }
    },
    {
      "name": "unaided_test",
      "kind": "OVERLAY_PROP_Z_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "unaided"
      }
    },
    {
      "name": "consider_change",
      "kind": "OVERLAY_DELTA_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "consider"
      }
    },
    {
      "name": "consider_test",
      "kind": "OVERLAY_PROP_Z_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "consider"
      }
    },
    {
      "name": "intent_t2b_change",
      "kind": "OVERLAY_DELTA_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "intent_t2b"
      }
    },
    {
      "name": "intent_t2b_test",
      "kind": "OVERLAY_PROP_Z_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "intent_t2b"
      }
    },
    {
      "name": "nps_change",
      "kind": "OVERLAY_DELTA_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "nps"
      }
    },
    {
      "name": "nps_test",
      "kind": "OVERLAY_Z_VS_PRIOR",
      "scope": "group",
      "params": {
        "field": "nps_variance"
      }
    }
  ],
  "multiplicity": {
    "method": "holm",
    "family": "request"
  }
