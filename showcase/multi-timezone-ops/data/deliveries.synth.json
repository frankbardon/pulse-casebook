  "rules": [
    {
      "set_expr": {
        "warehouse": "zone == \"America/Los_Angeles\" ? \"LAX\" : zone == \"America/Chicago\" ? \"ORD\" : zone == \"America/New_York\" ? \"NYC\" : zone == \"Europe/London\" ? \"LON\" : zone == \"Asia/Kolkata\" ? \"BLR\" : \"SYD\""
      }
    },
    {
      "set_expr": {
        "delivered_at": "warehouse == \"LAX\" ? local_lax : warehouse == \"ORD\" ? local_ord : warehouse == \"NYC\" ? local_nyc : warehouse == \"LON\" ? local_lon : warehouse == \"BLR\" ? local_blr : local_syd"
      }
    },
    {
      "set_expr": {
        "route": "warehouse + \"-R\" + string(int(1 + floor(8 * uniform())))",
        "duration_min": "round(10 * duration_min * (service_level == \"express\" ? 0.8 : 1) * (warehouse == \"SYD\" && between(delivered_at, \"2026-05-12\", \"2026-05-14\") ? 1.8 : 1)) / 10",
        "weight_kg": "round(100 * weight_kg) / 100"
      }
    },
    {
      "set_expr": {
        "p_on_time": "(warehouse == \"BLR\" ? 0.80 + trend(delivered_at, 0.15 / 182) : warehouse == \"LAX\" ? 0.91 : warehouse == \"ORD\" ? 0.92 : warehouse == \"NYC\" ? 0.90 : warehouse == \"LON\" ? 0.91 : 0.93) + 0.06 * (abs(sin(floor(trend(delivered_at, 1)) * 12.9898 + {\"LAX\": 1, \"ORD\": 2, \"NYC\": 3, \"LON\": 4, \"BLR\": 5, \"SYD\": 6}[warehouse] * 78.233) * 43758.5453) % 1) - 0.03"
      }
    },
    {
      "when": "warehouse == \"SYD\" && between(delivered_at, \"2026-05-12\", \"2026-05-14\")",
      "set": {
        "p_on_time": 0.45
      }
    },
    {
      "set_expr": {
        "on_time": "bernoulli(min(1, max(0, p_on_time)))"
      }
    }
  ]
